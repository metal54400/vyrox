{
  "appId": "com.orinstudio.vyrox",
  "appName": "Vyrox AI",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["localhost:3000", "127.0.0.1:3000"]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#0a0a1a"
  },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#0a0a1a"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a1a",
      "showSpinner": true,
      "spinnerColor": "#00f0ff"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a1a",
      "overlaysWebView": true
    }
  }
}