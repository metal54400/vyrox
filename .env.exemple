# Vyrox AI — copie ce fichier en .env et renseigne les valeurs

# Base de données MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vyrox
DB_USER=root
DB_PASS=

# IA (Groq / OpenAI compatible)
GROQ_API_KEY=
GROQ_MODEL_FREE=openai/gpt-oss-20b
GROQ_MODEL_PRO=llama-3.3-70b-versatile
API_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

# Crédits quotidiens des comptes gratuits
FREE_DAILY_CREDITS=20
