{
  "name": "vyrox-ai",
  "version": "2.0.0",
  "description": "Vyrox AI - Intelligence Artificielle Humaine by Orinstudio",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"node server.js\" \"wait-on http://localhost:3000 && electron .\"",
    "build:desktop": "electron-builder --win --mac --linux",
    "build:desktop:win": "electron-builder --win",
    "build:desktop:mac": "electron-builder --mac",
    "build:desktop:linux": "electron-builder --linux",
    "mobile:init": "npx cap init \"Vyrox AI\" \"com.orinstudio.vyrox\" --web-dir=public",
    "mobile:add:android": "npx cap add android",
    "mobile:add:ios": "npx cap add ios",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios"
  },
  "author": "Orinstudio",
  "license": "Orinstudio © 2026-2029",
  "build": {
    "appId": "com.orinstudio.vyrox",
    "productName": "Vyrox AI",
    "copyright": "Copyright © 2026-2029 Orinstudio",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "server.js",
      "vyrox-ai.js",
      "database.js",
      "auth.js",
      "vyrox.db",
      "node_modules/**/*",
      "cerveau.js",
      "auth.js",
      ".env",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.png",
      "artifactName": "Vyrox-AI-${version}-Setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "electron/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "concurrently": "^8.2.2",
    "dotenv": "^18.0.7",
    "fs": "^0.0.1-security",
    "https": "^1.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^5.7.0",
    "@capacitor/cli": "^5.7.0",
    "@capacitor/core": "^5.7.0",
    "@capacitor/ios": "^5.7.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1"
  }
}
